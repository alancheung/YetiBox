<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>1e23184f-ab1f-48c1-95f4-a18743b1c943</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>YetiBox.API</Name>
    <RootNamespace>YetiBox.API</RootNamespace>
    <InterpreterId>MSBuild|env313|$(MSBuildProjectFullPath)</InterpreterId>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <WebBrowserPort>8000</WebBrowserPort>
    <PythonRunWebServerCommand>
    </PythonRunWebServerCommand>
    <PythonDebugWebServerCommand>
    </PythonDebugWebServerCommand>
    <PythonRunWebServerCommandArguments>
    </PythonRunWebServerCommandArguments>
    <PythonDebugWebServerCommandArguments>
    </PythonDebugWebServerCommandArguments>
    <InterpreterPath>
    </InterpreterPath>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="camera\worker.py" />
    <Compile Include="constants.py" />
    <Compile Include="controllers\decompiler.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="controllers\stream.py" />
    <Compile Include="controllers\__init__.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="main.py" />
